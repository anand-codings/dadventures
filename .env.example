# Required
OPENAI_API_KEY=sk-...

# Optional (defaults shown)
PORT=53405
HOST=127.0.0.1
OUTPUT_DIR=output
IMAGE_MODEL=gpt-image-2.6-flare
ENHANCE_MODEL=gpt-5.4-mini
# Story Books writer
BOOK_MODEL=gpt-6-astra
# Flash Cards — writer (templates, plans, card text; default: BOOK_MODEL) and the vision model that reads existing cards (default: ENHANCE_MODEL)
CARD_MODEL=gpt-6-astra
CARD_VISION_MODEL=gpt-5.4-mini

# Optional — local upscaling with Real-ESRGAN (https://github.com/xinntao/Real-ESRGAN/releases, the ncnn-vulkan build).
# Point this at the binary; the models folder defaults to "models" next to it.
# REALESRGAN_BIN=/path/to/realesrgan-ncnn-vulkan
# REALESRGAN_MODELS=/path/to/realesrgan/models

# Optional — enables cloud upscalers (SeedVR2, Topaz) via fal.ai. Get a key at https://fal.ai/dashboard/keys
FAL_KEY=
# Print Sheets and Flash Cards — folder of your own images to browse (default: media/ in the app folder)
# PRINT_ROOT=/path/to/your/images
# Extra hostnames allowed to reach the app, comma separated (localhost and IP addresses always work)
# ALLOWED_HOSTS=studio.local
